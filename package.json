{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "build:analyze": "tsc -b && vite build --sourcemap",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "verify": "npm run typecheck && npm run typecheck:domain && npm run lint && npm run test:coverage && npm run test:domain && npm run build && npm run test:bundle && npm run test:rules",
    "typecheck:domain": "tsc -p tsconfig.domain.json",
    "test:domain": "vitest run --config vitest.domain.config.ts",
    "test:bundle": "vitest run --config vitest.bundle.config.ts",
    "gtfs:export": "node scripts/gtfs/export.mjs",
    "load:fleet": "firebase emulators:exec --project demo-brt --only database \"node scripts/load/fleet-load.mjs\"",
    "load:passengers": "firebase emulators:exec --project demo-brt --only database \"node scripts/load/passenger-load.mjs\"",
    "pretest:rules": "node scripts/free-emulator-ports.mjs",
    "test:rules": "firebase emulators:exec --project demo-brt --only firestore,database,auth \"vitest run --config vitest.rules.config.ts\"",
    "test:rules:db": "firebase emulators:exec --project demo-brt --only database \"npx vitest run --config vitest.rules.config.ts --pool=forks --poolOptions.forks.singleFork=true --poolOptions.forks.maxForks=1 src/test/rules/database.rules.test.ts\"",
    "test:rules:firestore": "firebase emulators:exec --project demo-brt --only firestore \"npx vitest run --config vitest.rules.config.ts --pool=forks --poolOptions.forks.singleFork=true --poolOptions.forks.maxForks=1 src/test/rules/firestore.rules.test.ts\""
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.10.0",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.13.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "firebase-tools": "^15.28.2",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  }
}
