rules_version = '2';

// BRT Bus Service - Firestore security rules.
//
// Design stance: deny by default, then grant the narrowest capability each
// screen actually needs. The client is treated as hostile - every rule here
// must hold even if the React app is bypassed entirely and requests are made
// straight against the REST API with a stolen-but-valid ID token.
//
// The single most important invariant: a user can create and edit their own
// profile, but can NEVER set or change their own `role`. Role changes are an
// admin-only operation, which is what stops privilege escalation.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Reads the caller's own profile to discover their role. This costs one
    // document read per rule evaluation, which is the accepted trade-off for
    // storing roles in Firestore rather than in custom claims.
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && callerRole() == 'admin';
    }

    function isValidRole(role) {
      return role is string && role in ['user', 'admin', 'driver'];
    }

    // Fields a user is allowed to author on their own profile.
    //
    // `email` is deliberately NOT here. It is identity provenance: it is
    // written once at registration from the verified auth token, it is what
    // an administrator reads when identifying an account, and it is carried
    // onto every ticket. A profile that can rewrite it lets any account
    // present itself to the admin roster as somebody else. Nothing in the
    // application has ever written it after creation, so excluding it costs
    // nothing - it was in this list by oversight, and the emulator caught it.
    function selfWritableKeys() {
      return ['name', 'photoURL', 'notifications_enabled', 'updatedAt'];
    }

    // ---- users ---------------------------------------------------------
    //
    // Holds identity and the role that every other authorization decision in
    // the app derives from. Treated as the crown jewels.

    match /users/{userId} {

      // Single-document reads: your own profile, or any profile if admin.
      allow get: if isOwner(userId) || isAdmin();

      // Collection queries are admin-only. Without splitting `list` from
      // `get`, any signed-in user could enumerate every account's name and
      // email - the mass-read the audit called out.
      allow list: if isAdmin();

      // Self-registration. Constrained so a new account cannot mint itself
      // as an admin, and cannot smuggle in unexpected fields.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'role', 'createdAt', 'photoURL', 'notifications_enabled']
           );

      // An admin provisioning a record for someone else (used when a role is
      // assigned to a user whose profile does not exist yet).
      allow create: if isAdmin()
        && isValidRole(request.resource.data.role);

      // Self-service profile edits. `role`, `email` and `createdAt` are
      // absent from the allowlist, so this path can never escalate privilege
      // or rewrite provenance.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(selfWritableKeys());

      // Role administration. Deliberately narrow: an admin may change a
      // role, but may not edit anyone else's name, email or photo.
      allow update: if isAdmin()
        && isValidRole(request.resource.data.role)
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['role', 'updatedAt']);

      // Account deletion is an out-of-band operation. Leaving it closed
      // prevents a compromised session from destroying the audit trail.
      allow delete: if false;
    }

    // ---- tickets -------------------------------------------------------
    //
    // Tickets are the source of truth here; the passenger's browser keeps a
    // copy so an already-synced ticket can still be shown with no network
    // (see `services/ticketService.ts`).
    //
    // `userId` is required on the document and pinned to the caller, so a
    // ticket cannot be created on someone else's behalf or reassigned.
    //
    // `list` is constrained to the caller's own tickets, not merely capped.
    // Without the ownership term any signed-in account could page through
    // everyone else's journeys, emails and validation tokens.

    match /tickets/{ticketId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn()
        && request.query.limit <= 100
        && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      // Only the mutable lifecycle fields; fare, stops and identity are
      // fixed at purchase so a holder cannot retro-price their own journey.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if false;
    }

    // ---- announcements -------------------------------------------------
    //
    // Operator notices shown on the public site, so read is open to everyone
    // including signed-out visitors. Only an administrator may author one:
    // this collection is the one place in the app where a human's words are
    // shown to passengers as fact.
    //
    // Length limits are enforced here as well as in the client schema,
    // because the client is the part an attacker controls.

    match /announcements/{announcementId} {
      allow read: if true;

      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000
        && request.resource.data.severity in ['INFO', 'WARNING', 'CRITICAL']
        && request.resource.data.active is bool;

      allow delete: if isAdmin();
    }

    // ---- audit log -----------------------------------------------------
    //
    // Who changed a role, and who published words that passengers read as
    // fact. Both are administrative acts with no other record: `users` keeps
    // only the current role, and an edited announcement overwrites the one
    // before it, so without this the question "who did this, and when?" has
    // no answer at all.
    //
    // Append-only, and the two fields that make it worth having are pinned to
    // values the client cannot choose. `actorUid` must equal the caller, so
    // an entry cannot be attributed to somebody else; `at` must equal the
    // server's own clock, so a record cannot be backdated into a shift nobody
    // was working. An audit trail an actor can author freely is not evidence.
    //
    // Volume is small - a few hundred writes a day against a 20,000/day free
    // allowance - so this costs nothing at this scale.

    match /auditLog/{entryId} {
      // Only an administrator can read it, and only the whole record.
      allow get, list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 64
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 128
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 512
        && request.resource.data.keys().hasOnly(
             ['actorUid', 'at', 'action', 'subject', 'detail']
           );

      // The point of the record is that it cannot be rewritten afterwards.
      // An administrator who can edit the log is an administrator with no log.
      allow update, delete: if false;
    }

    // ---- deny by default -----------------------------------------------
    //
    // Any collection not named above is closed. New features must add an
    // explicit rule, which means forgetting to write one fails safe.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
